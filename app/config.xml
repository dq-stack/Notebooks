<?xml version="1.0" encoding="utf-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:kindle="http://kindle.amazon.com/ns/widget-extensions"
        id="com.dqstack.notebooks" version="0.1.0" viewmodes="application">

    <name xml:lang="en">Notebooks</name>
    <description xml:lang="en">A notebook for every book on your Kindle.</description>
    <content src="index.html"/>

    <!-- No network: everything is local files. -->
    <kindle:settings>
        <kindle:setting name="internetRequired" value="no"/>
        <kindle:setting name="saveContext" value="no"/>
    </kindle:settings>

    <kindle:chrome>
        <kindle:asset key="configureSearchBar" value="system"/>
    </kindle:chrome>

    <kindle:gestures>
        <kindle:param name="tap" value="yes" properties="fire_on_tap:1 max_updown_delta:0"/>
        <kindle:param name="swipe" value="yes"/>
    </kindle:gestures>

    <feature name="http://kindle.amazon.com/apis" required="true">
        <param name="appmgr" value="yes"/>
        <param name="messaging" value="yes"/>
        <param name="chrome" value="yes"/>
        <param name="gestures" value="yes"/>
        <param name="localprefs" value="yes"/>
    </feature>

    <!-- The page may only message the system chrome bar and our own helper. -->
    <kindle:messaging>
        <kindle:app name="com.lab126.chromebar" value="yes"/>
        <kindle:app name="com.dqstack.notebooks.helper" value="yes"/>
    </kindle:messaging>
</widget>
